{
	"$schema": "http://json-schema.org/draft-07/schema#",
	"type": "object",
	"required": ["version", "exported", "name", "gamerules", "categories"],
	"properties": {
		"version": { "type": "number" },
		"exported": { "type": "number" },
		"name": { "type": "string" },
		"gamerules": {
			"required": ["gridSize"],
			"type": "object",
			"properties": {
				"winCondition": {
					"type": "string",
					"enum": ["row-col", "row-col-diag", "blackout"]
				},
				"star": {
					"type": "string",
					"enum": ["wildcard", "free", "disabled"]
				},
				"allowDuplicates": { "type": "boolean" },
				"gridSize": {
					"type": "string",
					"enum": ["small", "medium", "large"]
				},
				"allowSimilar": { "type": "boolean" },
				"seed": { "type": "string" }
			},
			"additionalProperties": false
		},
		"categories": {
			"type": "array",
			"items": {
				"type": "object",
				"required": ["uuid"],
				"properties": {
					"uuid": { "type": "string", "minLength": 1 },
					"name": { "type": "string" },
					"cat": { "type": "string" },
					"entry": { "type": "string" }
				},
				"anyOf": [
					{ "required": ["name"] },
					{ "required": ["cat"] }
				],
				"additionalProperties": false
			}
		}
	},
	"oneOf": [
		{
			"properties": {
				"gamerules": { "type": "object", "properties": { "gridSize": { "const": "small" } } },
				"categories": { "type": "array", "minItems": 9, "maxItems": 9 }
			}
		},
		{
			"properties": {
				"gamerules": { "type": "object", "properties": { "gridSize": { "const": "medium" } } },
				"categories": { "type": "array", "minItems": 25, "maxItems": 25 }
			}
		},
		{
			"properties": {
				"gamerules": { "type": "object", "properties": { "gridSize": { "const": "large" } } },
				"categories": { "type": "array", "minItems": 49, "maxItems": 49 }
			}
		}
	],
	"additionalProperties": false
}
